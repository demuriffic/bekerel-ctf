# ==========================================
# Capture the Flag (CTF) Platform Environment Configuration
# ==========================================

# Database Connection
# On Vercel: Connect Vercel Postgres / Neon integration (auto-configures DATABASE_URL)
# Locally: If empty, seamlessly uses embedded PGlite WASM database in .local_db
DATABASE_URL=

# Authentication Secret
AUTH_SECRET=cyber-defense-ctf-secret-change-in-production-2026

# Seed Administrator Credentials (Seeded on first startup)
ADMIN_EMAIL=admin@ctf.local
ADMIN_PASSWORD=AdminPassword123!
ADMIN_USERNAME=admin

# Platform Branding & Identity
NEXT_PUBLIC_CTF_NAME="CYBER_DEFENSE_CTF"
NEXT_PUBLIC_CTF_DESCRIPTION="Capture the Flag Competition — Hack the system, uncover flags, climb the leaderboard."
